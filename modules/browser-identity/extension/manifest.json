{
  "manifest_version": 3,
  "name": "NSp Browser Identity",
  "version": "0.1.0",
  "key": "",
  "description": "Local-only tab/document identity for NSp. Does not capture audio.",
  "permissions": [
    "tabs",
    "webNavigation",
    "debugger",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*"
  }
}