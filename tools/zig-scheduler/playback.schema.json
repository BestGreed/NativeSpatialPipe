{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "recording": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "pcm": {"type": "boolean", "default": false},
        "telemetrySnapshots": {"type": "boolean", "default": false}
      },
      "description": "Optional pre-DSP PCM side recording and telemetry JSONL archival. Both disabled by default."
    },
    "renderer": {
      "enum": [
        "roar",
        "olr",
        "lira"
      ],
      "default": "roar"
    },
    "mode": {
      "enum": [
        "olr",
        null
      ],
      "default": null
    },
    "bridgeDll": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Absolute path; runtime additionally validates Windows path syntax and NUL exclusion."
    },
    "rendererDll": {
      "type": "string",
      "default": ""
    },
    "asioDll": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Absolute path; runtime additionally validates Windows path syntax and NUL exclusion."
    },
    "driver": {
      "type": "string",
      "pattern": "^asio:",
      "maxLength": 4095
    },
    "sourceStream": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "default": 0
    },
    "channelOrder": {
      "enum": [
        "olr",
        "dvs-speakers",
        "custom"
      ],
      "default": "olr"
    },
    "sampleRate": {
      "type": "number",
      "minimum": 8000,
      "maximum": 384000,
      "default": 48000
    },
    "bufferFrames": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536,
      "default": 0
    },
    "master": {
      "type": "number",
      "minimum": 0,
      "maximum": 16,
      "default": 1
    },
    "outputProcessing": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "trim": {
          "type": "array",
          "minItems": 8,
          "maxItems": 16,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 16,
            "default": 1
          }
        },
        "delayFrames": {
          "type": "array",
          "minItems": 8,
          "maxItems": 16,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 48000,
            "default": 0
          }
        },
        "limiter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "ceiling": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "default": 1
            },
            "releaseMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000,
              "default": 50
            },
            "lookaheadFrames": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4800,
              "default": 0
            }
          }
        },
        "bypass": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "positionMapping": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "scaled",
            "direction"
          ],
          "default": "scaled"
        },
        "reference": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "direction"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "reference": {
                "const": 1
              }
            }
          }
        }
      ]
    },
    "routing": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceChannelIndices": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 8,
              "maxItems": 16,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 11
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "physicalChannels": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 8,
              "maxItems": 16,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "clockSync": {
      "type": "boolean",
      "default": true
    },
    "prebufferFrames": {
      "type": "integer",
      "minimum": 0,
      "maximum": 48000,
      "default": 0
    },
    "startupTimeoutMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "default": 0,
      "deprecated": true,
      "description": "Compatibility only; ignored. ASIO stays active with silent callbacks until the session ends."
    },
    "rebufferTimeoutMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "default": 0,
      "deprecated": true,
      "description": "Compatibility only; ignored. Source gaps do not terminate the ASIO session."
    },
    "maxRebuffers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "default": 0,
      "deprecated": true,
      "description": "Compatibility only; ignored. Rebuffer count is diagnostic, not a session lifetime limit."
    },
    "drainTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295,
      "default": 5000
    },
    "outputLayout": {
      "type": "string",
      "enum": [
        "5.1.2",
        "5.1.4",
        "7.1.2",
        "7.1.4",
        "7.1.6",
        "9.1.4",
        "9.1.6",
        "roar-custom-6dof"
      ],
      "default": "7.1.4",
      "description": "Selected speaker output geometry. roar-custom-6dof is reserved and rejected by runtime."
    },
    "roarCustomLayout": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "measurementFile": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ],
      "description": "ROAR-only reserved measurement slot. Not loaded or activated."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NSP per-session playback configuration",
  "required": [
    "bridgeDll",
    "asioDll",
    "driver"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "renderer": {
            "const": "lira"
          }
        },
        "required": [
          "renderer"
        ]
      },
      "then": {
        "required": [
          "rendererDll"
        ],
        "properties": {
          "rendererDll": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Absolute path; runtime additionally validates Windows path syntax and NUL exclusion."
          },
          "mode": {
            "type": "null"
          },
          "positionMapping": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "channelOrder": {
            "const": "custom"
          }
        },
        "required": [
          "channelOrder"
        ]
      },
      "then": {
        "required": [
          "routing"
        ],
        "properties": {
          "routing": {
            "type": "object",
            "required": [
              "sourceChannelIndices"
            ],
            "properties": {
              "sourceChannelIndices": {
                "type": "array",
                "minItems": 8,
                "maxItems": 16,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 11
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "routing": {
            "properties": {
              "sourceChannelIndices": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
