+    /// Prepare the fixed speaker geometry before the first captured packet.
+    /// Independent contexts own independent calculators; binaural routing is unchanged.
+    pub fn prepare_olr_geometry(&mut self) -> Result<(), OarError> {
+        if self.config.output_layout() == Layout::Binaural {
+            return Err(OarError::NotSupported);
+        }
+        self.shared_olr_geometry(self.config.output_layout())?;
+        Ok(())
+    }
+
+    fn shared_olr_geometry(&mut self, layout: Layout) -> Result<Arc<dyn GainCalculator>, OarError> {
+        if let Some((prepared_layout, calculator)) = &self.olr_geometry {
+            if *prepared_layout != layout {
+                return Err(OarError::InvalidParameter);
+            }
+            return Ok(Arc::clone(calculator));
+        }
+        let calculator: Arc<dyn GainCalculator> = Arc::new(CustomGainCalculator::new(layout)?);
+        self.olr_geometry = Some((layout, Arc::clone(&calculator)));
+        Ok(calculator)
+    }
