+
+// Exact zero only, checked on the contributing overlap after shape validation.
+// Metadata interpretation and queue/time advancement remain in the caller.
+fn silent_overlap(input:&[f32], samples:usize, channels:usize, range:&std::ops::Range<usize>)->bool {
+    if channels.checked_mul(samples).is_none_or(|n| n>input.len()) {return false;}
+    (0..channels).all(|c| input[c*samples+range.start..c*samples+range.end].iter().all(|v|*v==0.0))
+}
